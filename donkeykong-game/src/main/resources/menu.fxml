<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<StackPane fx:id="gameContainer" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="800.0" prefWidth="1000.0" styleClass="dk-screen" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="vsb.cz.fei.donkeykongfx.controllers.MenuController">
   <children>
      <BorderPane fx:id="mainMenu" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="543.0" prefWidth="1000.0" styleClass="dk-screen">
         <center>
            <VBox prefHeight="200.0" prefWidth="1000.0" BorderPane.alignment="BOTTOM_CENTER">
               <children>
                  <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" prefHeight="253.0" prefWidth="1000.0" VBox.vgrow="ALWAYS">
                     <opaqueInsets>
                        <Insets />
                     </opaqueInsets>
                     <children>
                        <VBox alignment="CENTER" maxHeight="1.7976931348623157E308" maxWidth="-Infinity" minWidth="-Infinity" spacing="16.0">
                           <children>
                              <TableView id="scoreTable" fx:id="scoreTable" maxWidth="1.7976931348623157E308" prefHeight="206.0" prefWidth="320.0" styleClass="dk-table">
                                <columns>
                                  <TableColumn fx:id="columnNickName" prefWidth="188.0" text="%menu.nickname" />
                                  <TableColumn fx:id="columnScore" prefWidth="132.0" text="%menu.score" />
                                </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <TextField fx:id="playerNameField" maxWidth="1.7976931348623157E308" promptText="%menu.playerName" />
                              <Button fx:id="continueButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onBtnContinue" styleClass="dk-button-large" text="%menu.continue" />
                              <Button fx:id="startButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onBtnStart" styleClass="dk-button-large" text="%menu.start" />
                              <Button fx:id="optionsButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onBtnOptions" styleClass="dk-button-large" text="%menu.options" />
                              <Button fx:id="quitButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#onBtnQuit" styleClass="dk-button-large" text="%menu.quit" />
                           </children>
                        </VBox>
                        <StackPane fx:id="canvaContainer" prefHeight="600.0" prefWidth="590.0">
                           <children>
                              <Canvas fx:id="canvas" height="256.0" width="384.0" />
                           </children>
                        </StackPane>
                     </children>
                  </HBox>
               </children>
            </VBox>
         </center>
         <top>
            <BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="150.0" prefWidth="1000.0" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets top="50.0" />
               </BorderPane.margin>
               <top>
                  <Text styleClass="dk-title" smooth="false" strokeType="OUTSIDE" strokeWidth="0.0" text="%menu.title" textAlignment="CENTER" wrappingWidth="1000.0" BorderPane.alignment="CENTER" />
               </top>
            </BorderPane>
         </top>
      </BorderPane>
   </children>
</StackPane>
